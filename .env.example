# =====================================================================
# SMART INTERVIEW SCHEDULER - environment template
# Copy to .env and fill in. NEVER commit the real .env file.
# Every external dependency has a mock fallback, so the defaults below
# run the whole platform with zero external accounts (DEMO MODE).
# =====================================================================

# ---------- Database ----------
# SQLite (default, zero-infrastructure demo):
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"
# PostgreSQL (run `npm run db:use-postgres` after switching these):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_scheduler?schema=public"
# DATABASE_PROVIDER="postgresql"

# ---------- Backend ----------
NODE_ENV="development"
PORT="4000"
CORS_ORIGIN="http://localhost:5173"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-dev-only-access-secret"
JWT_REFRESH_SECRET="change-me-dev-only-refresh-secret"
JWT_ACCESS_TTL="30m"
JWT_REFRESH_TTL="7d"
BCRYPT_ROUNDS="10"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="300"
AUTH_RATE_LIMIT_MAX="20"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="2097152"

# ---------- AI / optimization service ----------
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_SERVICE_TIMEOUT_MS="20000"
AI_SERVICE_TOKEN="dev-shared-service-token"

# ---------- AI provider ----------
# mock | gemini | ollama   (mock = deterministic offline provider, no key needed)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1"
# local | sentence-transformers (the latter needs `pip install sentence-transformers`)
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# ---------- Calendar provider ----------
# mock | google
CALENDAR_PROVIDER="mock"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/calendar/oauth/callback"

# ---------- Meeting provider ----------
# jitsi | mock | google_meet
MEETING_PROVIDER="jitsi"
JITSI_DOMAIN="meet.jit.si"

# ---------- Notification provider ----------
# mock | smtp    (mock writes to the DB + a local outbox file; no credentials needed)
NOTIFICATION_PROVIDER="mock"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Interview Control Tower <no-reply@scheduler.local>"
# optional SMS (twilio); leave blank to disable
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ---------- Scheduling policy defaults (overridable per-tenant in SystemSetting) ----------
DEFAULT_BUFFER_MINUTES="15"
SLOT_GRANULARITY_MINUTES="15"
SIMULATION_ITERATIONS="200"
AUTONOMY_AUTO_APPLY_MAX_RISK="LOW"
MONITOR_INTERVAL_MS="60000"
MONITOR_ENABLED="true"

# ---------- Frontend (Vite) ----------
VITE_API_URL="http://localhost:4000/api"
